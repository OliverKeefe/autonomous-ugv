<?xml version="1.0" ?>
<robot name="limo_four_diff_final">
  <link name="base_footprint"/>
  
  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin rpy="0 0 0" xyz="0.0 0.0 0.15"/>
  </joint>
  
  <link name="base_link">
    <visual>
      <origin rpy="0 0 1.57" xyz="0 0 -0.15"/>
      <geometry>
        <mesh filename="model://limo_sim/meshes/limo_base.dae" scale="1 1 1"/>
      </geometry>
    </visual>
    <inertial>
      <origin xyz="0.0 0.0 0.0"/>
      <mass value="1.5"/>
      <inertia ixx="0.00355" ixy="0" ixz="0" iyy="0.00424" iyz="0" izz="0.00621"/>
    </inertial>
  </link>

  <link name="caster_fl_link"><inertial><mass value="0.1"/><inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/></inertial><collision><geometry><sphere radius="0.005"/></geometry><surface><friction><ode><mu>0.0</mu><mu2>0.0</mu2></ode></friction><contact><ode><minDepth>0.001</minDepth></ode></contact></surface></collision></link>
  <link name="caster_fr_link"><inertial><mass value="0.1"/><inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/></inertial><collision><geometry><sphere radius="0.005"/></geometry><surface><friction><ode><mu>0.0</mu><mu2>0.0</mu2></ode></friction><contact><ode><minDepth>0.001</minDepth></ode></contact></surface></collision></link>
  <link name="caster_rl_link"><inertial><mass value="0.1"/><inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/></inertial><collision><geometry><sphere radius="0.005"/></geometry><surface><friction><ode><mu>0.0</mu><mu2>0.0</mu2></ode></friction><contact><ode><minDepth>0.001</minDepth></ode></contact></surface></collision></link>
  <link name="caster_rr_link"><inertial><mass value="0.1"/><inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/></inertial><collision><geometry><sphere radius="0.005"/></geometry><surface><friction><ode><mu>0.0</mu><mu2>0.0</mu2></ode></friction><contact><ode><minDepth>0.001</minDepth></ode></contact></surface></collision></link>
  
  <joint name="caster_fl_joint" type="fixed"><parent link="base_link"/><child link="caster_fl_link"/><origin xyz="0.1 0.086 -0.14"/></joint>
  <joint name="caster_fr_joint" type="fixed"><parent link="base_link"/><child link="caster_fr_link"/><origin xyz="0.1 -0.086 -0.14"/></joint>
  <joint name="caster_rl_joint" type="fixed"><parent link="base_link"/><child link="caster_rl_link"/><origin xyz="-0.1 0.086 -0.14"/></joint>
  <joint name="caster_rr_joint" type="fixed"><parent link="base_link"/><child link="caster_rr_link"/><origin xyz="-0.1 -0.086 -0.14"/></joint>

  <link name="drive_wheel_left_link">
    <inertial><mass value="0.25"/><inertia ixx="0.00026" ixy="0" ixz="0" iyy="0.00025" iyz="0" izz="0.00026"/></inertial>
    <collision><origin rpy="1.57 0 0" xyz="0 0 0"/><geometry><cylinder length="0.045" radius="0.045"/></geometry><surface><contact><ode><kp>1000000</kp><kd>100</kd><minDepth>0.001</minDepth></ode></contact><friction><ode><mu>10.0</mu><mu2>10.0</mu2></ode></friction></surface></collision>
  </link>
  <link name="drive_wheel_right_link">
    <inertial><mass value="0.25"/><inertia ixx="0.00026" ixy="0" ixz="0" iyy="0.00025" iyz="0" izz="0.00026"/></inertial>
    <collision><origin rpy="1.57 0 0" xyz="0 0 0"/><geometry><cylinder length="0.045" radius="0.045"/></geometry><surface><contact><ode><kp>1000000</kp><kd>100</kd><minDepth>0.001</minDepth></ode></contact><friction><ode><mu>10.0</mu><mu2>10.0</mu2></ode></friction></surface></collision>
  </link>

  <joint name="drive_wheel_left_joint" type="continuous"><parent link="base_link"/><child link="drive_wheel_left_link"/><origin rpy="0 0 0" xyz="0 0.086 -0.1"/><axis xyz="0 1 0"/></joint>
  <joint name="drive_wheel_right_joint" type="continuous"><parent link="base_link"/><child link="drive_wheel_right_link"/><origin rpy="3.14159 0 0" xyz="0 -0.086 -0.1"/><axis xyz="0 -1 0"/></joint>

  <link name="front_left_wheel_link">
    <inertial><mass value="0.001"/><inertia ixx="1e-7" ixy="0" ixz="0" iyy="1e-7" iyz="0" izz="1e-7"/></inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="model://limo_sim/meshes/limo_wheel.dae"/>
      </geometry>
    </visual>
  </link>
  <link name="front_right_wheel_link">
    <inertial><mass value="0.001"/><inertia ixx="1e-7" ixy="0" ixz="0" iyy="1e-7" iyz="0" izz="1e-7"/></inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="model://limo_sim/meshes/limo_wheel.dae"/>
      </geometry>
    </visual>
  </link>
  <link name="rear_left_wheel_link">
    <inertial><mass value="0.001"/><inertia ixx="1e-7" ixy="0" ixz="0" iyy="1e-7" iyz="0" izz="1e-7"/></inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="model://limo_sim/meshes/limo_wheel.dae"/>
      </geometry>
    </visual>
  </link>
  <link name="rear_right_wheel_link">
    <inertial><mass value="0.001"/><inertia ixx="1e-7" ixy="0" ixz="0" iyy="1e-7" iyz="0" izz="1e-7"/></inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="model://limo_sim/meshes/limo_wheel.dae"/>
      </geometry>
    </visual>
  </link>
  
  <joint name="front_left_wheel_joint" type="continuous"><parent link="base_link"/><child link="front_left_wheel_link"/><origin rpy="0 0 0" xyz="0.1 0.065 -0.1"/><axis xyz="0 1 0"/></joint>
  <joint name="front_right_wheel_joint" type="continuous"><parent link="base_link"/><child link="front_right_wheel_link"/><origin rpy="3.14159 0 0" xyz="0.1 -0.065 -0.1"/><axis xyz="0 -1 0"/></joint>
  <joint name="rear_left_wheel_joint" type="continuous"><parent link="base_link"/><child link="rear_left_wheel_link"/><origin rpy="0 0 0" xyz="-0.1 0.065 -0.1"/><axis xyz="0 1 0"/></joint>
  <joint name="rear_right_wheel_joint" type="continuous"><parent link="base_link"/><child link="rear_right_wheel_link"/><origin rpy="3.14159 0 0" xyz="-0.1 -0.065 -0.1"/><axis xyz="0 -1 0"/></joint>

  <link name="laser_link">
    <inertial><mass value="0.1"/><inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/></inertial>
    <visual><geometry><cylinder length="0.01" radius="0.02"/></geometry></visual>
    <collision><geometry><cylinder length="0.016" radius="0.032"/></geometry></collision>
  </link>
  <joint name="laser_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0.103 0 -0.034"/>
    <child link="laser_link"/>
    <parent link="base_link"/>
  </joint>
  
  <link name="depth_camera_link">
    <inertial><mass value="0.1"/><inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/></inertial>
    <visual><geometry><box size="0.02 0.06 0.015"/></geometry></visual>
    <collision><geometry><box size="0.02 0.06 0.015"/></geometry></collision>
  </link>
  <joint name="depth_camera_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0.084 0 0.03"/>
    <child link="depth_camera_link"/>
    <parent link="base_link"/>
  </joint>
  
  <link name="depth_link"/>
  <joint name="depth_camera_to_camera_joint" type="fixed">
    <origin rpy="-1.57 0 -1.57 " xyz="0 0 0"/>
    <parent link="depth_camera_link"/>
    <child link="depth_link"/>
  </joint>
  
  <link name="imu_link">
    <inertial><mass value="0.01"/><inertia ixx="1e-7" ixy="0" ixz="0" iyy="1e-7" iyz="0" izz="1e-7"/></inertial>
    <visual><geometry><box size="0.001 0.001 0.001"/></geometry></visual>
    <collision><geometry><box size="0.001 0.001 0.001"/></geometry></collision>
  </link>
  <joint name="imu_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0.0 0 -0.1"/>
    <child link="imu_link"/>
    <parent link="base_link"/>
  </joint>

  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>drive_wheel_left_joint</left_joint>
      <right_joint>drive_wheel_right_joint</right_joint>
      <left_joint>front_left_wheel_joint</left_joint>
      <left_joint>rear_left_wheel_joint</left_joint>
      <right_joint>front_right_wheel_joint</right_joint>
      <right_joint>rear_right_wheel_joint</right_joint>
      <wheel_separation>0.172</wheel_separation>
      <wheel_radius>0.045</wheel_radius>
      <topic>cmd_vel</topic>
      <odom_topic>odom</odom_topic>
      <tf_topic>/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <odom_publisher_frequency>50</odom_publisher_frequency>
    </plugin>
  </gazebo>
  
  <gazebo reference="imu_link">
    <sensor name="twr_imu" type="imu">
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <visualize>true</visualize>
      <topic>imu</topic>
    </sensor>
  </gazebo>

  <gazebo reference="laser_link">
    <sensor name="laser" type="gpu_lidar">
      <pose>0 0 0 0 0 0</pose>
      <always_on>true</always_on>
      <visualize>true</visualize>
      <update_rate>10</update_rate>
      <topic>scan</topic>
      <lidar>
        <scan>
          <horizontal>
            <samples>243</samples>
            <resolution>1</resolution>
            <min_angle>-1.91986</min_angle>
            <max_angle>1.91986</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.035</min> <max>16.0</max> <resolution>0.015</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>

  <gazebo reference="depth_camera_link">
      <sensor name="camera" type="depth_camera">
          <topic>depth</topic>
          <update_rate>10</update_rate>
          <camera>
              <horizontal_fov>1.0</horizontal_fov>
              <image>
                  <width>640</width>
                  <height>480</height>
              </image>
              <clip>
                  <near>0.1</near>
                  <far>10.0</far>
              </clip>
          </camera>
          <always_on>1</always_on>
          <visualize>true</visualize>
      </sensor>
  </gazebo>
</robot>
