<?xml version="1.0"?>
<sdf version='1.6'>
  <world name='default'>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <light name='Sunlight' type='directional'>
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.2 0.3 -1</direction>
    </light>

    <model name='groundPlane'>
      <static>true</static>
      <pose>1 1 0 0 0 0</pose> 
      <link name='groundPlane_link'>  
        <collision name='groundPlane_collision'>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>4 4</size>
            </plane>
          </geometry>
        </collision>

        <visual name='Grid_Horiz_1'>
          <pose>0 -1 0.001 0 0 0</pose> <geometry><box><size>4 0.02 0.001</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>
        <visual name='Grid_Horiz_2'>
          <pose>0 0 0.001 0 0 0</pose> <geometry><box><size>4 0.02 0.001</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>
        <visual name='Grid_Horiz_3'>
          <pose>0 1 0.001 0 0 0</pose> <geometry><box><size>4 0.02 0.001</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>

        <visual name='Grid_Vert_1'>
          <pose>-1 0 0.001 0 0 1.57</pose> <geometry><box><size>4 0.02 0.001</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>
        <visual name='Grid_Vert_2'>
          <pose>0 0 0.001 0 0 1.57</pose> <geometry><box><size>4 0.02 0.001</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>
        <visual name='Grid_Vert_3'>
          <pose>1 0 0.001 0 0 1.57</pose> <geometry><box><size>4 0.02 0.001</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>

        <visual name='groundPlane_Visual'>
            <geometry>
              <plane>
                <normal>0 0 1</normal>
                <size>4 4</size>
              </plane>
            </geometry>
            <material>
              <script>
                <uri>file://media/materials/scripts/gazebo.material</uri>
                <name>Gazebo/White</name>
              </script>
            </material>
        </visual>
      </link>
    </model>

    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type='adiabatic'/>
    
    <physics type="ode">
      <real_time_update_rate>1000.0</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <ode>
        <solver>
          <type>quick</type>
          <iters>150</iters>
          <precon_iters>0</precon_iters>
          <sor>1.4</sor>
          <use_dynamic_moi_rescaling>true</use_dynamic_moi_rescaling>
        </solver>
        <constraints>
          <cfm>0.00001</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>2000.0</contact_max_correcting_vel>
          <contact_surface_layer>0.01</contact_surface_layer>
        </constraints>
      </ode>
    </physics>
    
    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
      <grid>false</grid>
    </scene>
    
    <gui fullscreen='0'>
      <camera name='user_camera'>
        <pose>0 0 5 0 -1.5707 3.14159</pose>
        <view_controller>orbit</view_controller>
        <projection_type>perspective</projection_type>
      </camera>
    </gui>

    <model name='Walls'>
      <static>true</static>
      <pose>1.5 1.5 0 0 -0 0</pose>
      <link name='Top Wall'>
        <pose>-1.875 -0.55 -0.5 0 -0 1.5708</pose>
        <visual name='Top_Wall_Visual'>
          <pose>0 0 0.75 0 -0 0</pose>
          <geometry>
            <box>
              <size>2.5 0.15 0.75</size>
            </box>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Grey</name>
            </script>
            <double_sided>true</double_sided>
          </material>
          <cast_shadows>true</cast_shadows>
        </visual>
        <collision name='Top_Wall_Collision'>
          <pose>0 0 0.75 0 -0 0</pose>
          <geometry>
            <box>
              <size>2.5 0.15 0.75</size>
            </box>
          </geometry>
        </collision>
      </link>
      <link name='Bottom Wall'>
        <pose>0.775 -0.55 -0.5 0 -0 1.5708</pose>
        <visual name='Bottom_Wall_Visual'>
          <pose>0 0 0.75 0 -0 0</pose>
          <geometry>
            <box>
              <size>2.5 0.15 0.75</size>
            </box>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Grey</name>
            </script>
            <double_sided>true</double_sided>
          </material>
          <cast_shadows>true</cast_shadows>
        </visual>
        <collision name='Bottom_Wall_Collision'>
          <pose>0 0 0.75 0 -0 0</pose>
          <geometry>
            <box>
              <size>2.5 0.15 0.75</size>
            </box>
          </geometry>
        </collision>
      </link>
      <link name='Right Wall'>
        <pose>-0.55 0.775 -0.5 0 -0 3.14159</pose>
        <visual name='Right_Wall_Visual'>
          <pose>0 0 0.75 0 -0 0</pose>
          <geometry>
            <box>
              <size>2.8 0.15 0.75</size>
            </box>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Grey</name>
            </script>
            <double_sided>true</double_sided>
          </material>
          <cast_shadows>true</cast_shadows>
        </visual>
        <collision name='Right_Wall_Collision'>
          <pose>0 0 0.75 0 -0 0</pose>
          <geometry>
            <box>
              <size>2.8 0.15 0.75</size>
            </box>
          </geometry>
        </collision>
      </link>
      <link name='Left Wall'>
        <pose>-0.55 -1.875 -0.5 0 -0 3.14159</pose>
        <visual name='Left_Wall_Visual'>
          <pose>0 0 0.75 0 -0 0</pose>
          <geometry>
            <box>
              <size>2.8 0.15 0.75</size>
            </box>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Grey</name>
            </script>
            <double_sided>true</double_sided>
          </material>
          <cast_shadows>true</cast_shadows>
        </visual>
        <collision name='Left_Wall_Collision'>
          <pose>0 0 0.75 0 -0 0</pose>
          <geometry>
            <box>
              <size>2.8 0.15 0.75</size>
            </box>
          </geometry>
        </collision>
      </link>
    </model>
    
    <model name='Pillars'>
      <static>true</static>
      <pose>2.1037 1.06319 0.624991 0 0 -9e-06</pose>
      <link name='Pillar_T1'>
        <pose>-1.605 0.135 -0.25 0 -0 0</pose>
        <visual name='Pillar_T1_Visual'>
          <geometry>
            <cylinder>
              <radius>0.125</radius>
              <length>0.75</length>
            </cylinder>
          </geometry>
          <material>
            <script>
              <name>Gazebo/Grey</name>
              <uri>file://media/materials/scripts/gazebo.material</uri>
            </script>
          </material>
        </visual>
        <collision name='Pillar_T1_Collision'>
          <geometry>
            <cylinder>
              <radius>0.125</radius>
              <length>0.75</length>
            </cylinder>
          </geometry>
        </collision>
      </link>
      <link name='Pillar_T2'>
        <pose>-1.605 0.885 -0.25 0 -0 9e-06</pose>
        <visual name='Pillar_T2_Visual'>
          <geometry>
            <cylinder>
              <radius>0.125</radius>
              <length>0.75</length>
            </cylinder>
          </geometry>
          <material>
            <script>
              <name>Gazebo/Grey</name>
              <uri>file://media/materials/scripts/gazebo.material</uri>
            </script>
          </material>
        </visual>
        <collision name='Pillar_T2_Collision'>
          <geometry>
            <cylinder>
              <radius>0.125</radius>
              <length>0.75</length>
            </cylinder>
          </geometry>
        </collision>
      </link>
      <link name='Pillar_T3'>
        <pose>-0.705 -0.365 -0.25 0 -0 9e-06</pose>
        <visual name='Pillar_T3_Visual'>
          <geometry>
            <cylinder>
              <radius>0.125</radius>
              <length>0.75</length>
            </cylinder>
          </geometry>
          <material>
            <script>
              <name>Gazebo/Grey</name>
              <uri>file://media/materials/scripts/gazebo.material</uri>
            </script>
          </material>
        </visual>
        <collision name='Pillar_T3_Collision'>
          <geometry>
            <cylinder>
              <radius>0.125</radius>
              <length>0.75</length>
            </cylinder>
          </geometry>
        </collision>
      </link>
      <link name='Pillar_T4'>
        <pose>-0.205 -0.065 -0.25 0 -0 9e-06</pose>
        <visual name='Pillar_T4_Visual'>
          <geometry>
            <cylinder>
              <radius>0.125</radius>
              <length>0.75</length>
            </cylinder>
          </geometry>
          <material>
            <script>
              <name>Gazebo/Grey</name>
              <uri>file://media/materials/scripts/gazebo.material</uri>
            </script>
          </material>
        </visual>
        <collision name='Pillar_T4_Collision'>
          <geometry>
            <cylinder>
              <radius>0.125</radius>
              <length>0.75</length>
            </cylinder>
          </geometry>
        </collision>
      </link>
    </model>

    <model name='Final Marker'>
      <static>true</static>
      <pose>2.0 0.0 0.025 0 0 0</pose>
      <link name='Final_Marker_Link'>
        <visual name='Final_Marker_Visual'>
          <geometry>
            <cylinder>
              <radius>0.125</radius>
              <length>0.01</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>1 0 0 1</ambient>
            <diffuse>1 0 0 1</diffuse>
          </material>
        </visual>
        </link>
    </model>
  </world>
</sdf>
